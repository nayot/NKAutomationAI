# BUU e-Doc system (https://doc.buu.ac.th/docweb/v2/)
EDOC_USERNAME=
EDOC_PASSWORD=
INBOX=                      # Exact inbox link text, e.g. "ผศ. ดร. ณยศ ..."

# BUU e-Sign (https://e-sign.buu.ac.th)
# Leave blank to reuse EDOC_USERNAME / EDOC_PASSWORD
ESIGN_USERNAME=
ESIGN_PASSWORD=

# SAP Fiori (https://buusapwdpap00.buu.ac.th:44301)
FIORI_USERNAME=
FIORI_PASSWORD=

# Gmail OAuth2 — get Client ID + Secret from Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client IDs → Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
