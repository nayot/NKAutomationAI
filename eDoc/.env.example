EDOC_USERNAME=your_username_here
EDOC_PASSWORD=your_password_here
INBOX="คณบดีคณะวิศวกรรมศาสตร์"
OPENROUTER_API_KEY=your_openrouter_api_key_here
HEADLESS=false

# Optional. Any model slug from https://openrouter.ai/models.
# For attachment summaries to work, the model needs "file" in its
# architecture.input_modalities (https://openrouter.ai/api/v1/models) — plus
# "image" for scanned documents. A model listing only "image" cannot accept a PDF.
# Prefer a model that does not reason by default; see EDOC_AI_PDF_ENGINE below.
#   openai/gpt-4o-mini            – cheap, file+image, no reasoning tokens
#   anthropic/claude-haiku-4.5    – pricier, same properties
#   google/gemini-2.5-flash       – large context, strongest on scans
#   anthropic/claude-sonnet-4.6   – highest quality Thai reasoning
EDOC_AI_MODEL=openai/gpt-4o-mini

# Optional. Second model, retried when the primary returns 5xx / 429 / connection
# errors — and, for attachment summaries only, on a 4xx or an empty response, since
# there those mean the model cannot read the PDF (401/402/403 never retry).
# Set to an empty value to disable the fallback entirely.
EDOC_AI_FALLBACK_MODEL=anthropic/claude-haiku-4.5

# Optional. Output-token cap per request (default 16000). Raise it only if your
# chosen model allows more — an over-large value is rejected outright, not clamped.
EDOC_AI_MAX_TOKENS=16000

# Optional. How attachment PDFs are handled (default: native).
#   native        – hand the PDF straight to the model, billed as input tokens.
#                   Requires a model listing "file" among its input modalities;
#                   with any other model the summary is skipped (ranking still works).
#                   A text-only model fails here either loudly (400/422 "Input should
#                   be a valid string") or silently (200 with empty content), so pick
#                   cloudflare-ai instead unless the model reads PDFs natively.
#   cloudflare-ai – OpenRouter converts the PDF to markdown. Free, but text-only,
#                   so scanned/image documents come back empty.
#   mistral-ocr   – real OCR, best for scanned documents. Charged per 1,000 pages
#                   to your OpenRouter account.
# Leave the value empty to let OpenRouter pick: native when the model supports it,
# otherwise the PAID mistral-ocr engine.
# Note: a reasoning model can consume the whole attachment token budget thinking and
# return an empty summary with no error — set ATTACHMENT_REASONING_EFFORT = "low" in
# edoc/analyzer.py if EDOC_AI_MODEL reasons by default.
EDOC_AI_PDF_ENGINE=native

# Optional. Override only for a proxy or an OpenAI-compatible gateway other than
# OpenRouter. Default: https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=
