EDOC_USERNAME=your_username_here
EDOC_PASSWORD=your_password_here
INBOX="คณบดีคณะวิศวกรรมศาสตร์"
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HEADLESS=false

# Optional. Anthropic model used for ranking + command suggestion.
# Default: claude-haiku-4-5-20251001 (cheap/fast). Use claude-sonnet-4-6 for higher quality.
EDOC_AI_MODEL=claude-haiku-4-5-20251001

# Optional. OpenAI fallback — only used when Anthropic returns 5xx/overload/connection errors.
# Leave OPENAI_API_KEY blank to disable the fallback entirely.
# Default fallback model: gpt-4o-mini (cheapest reliable Thai + native PDF support).
OPENAI_API_KEY=
EDOC_AI_FALLBACK_MODEL=gpt-4o-mini
